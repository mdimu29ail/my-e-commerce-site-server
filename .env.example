# ─────────────────────────────────────────────────────────────────────────────
# SERVER ENVIRONMENT VARIABLES — TEMPLATE
#
# Copy this file to .env for local development.
# NEVER commit .env with real credentials.
#
# For Vercel Production:
#   Go to → Vercel Dashboard → Your Project → Settings → Environment Variables
#   Add each variable listed below with its real production value.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database (MongoDB Atlas) ──────────────────────────────────────────────────
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# REQUIRED — the server will refuse to start without this.
MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.XXXXX.mongodb.net/ecommerce?appName=Cluster0

# ── Authentication ─────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_string
# JWT_EXPIRE=30d   (optional, defaults to 30d)

# ── Application URLs ──────────────────────────────────────────────────────────
# Development:
FRONTEND_URL=http://localhost:5173
BACKEND_URL=https://my-e-commerce-site-server.vercel.app

# Production (set these in Vercel Dashboard, not here):
# FRONTEND_URL=https://your-frontend.vercel.app
# BACKEND_URL=https://your-server.vercel.app

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# Get these from: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_service_account@your_project.iam.gserviceaccount.com
# Store the private key as a single line with \n representing newlines.
# In Vercel Dashboard: paste the exact private key string from the JSON file.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your_project.appspot.com

# ── ImgBB (Image Hosting) ────────────────────────────────────────────────────
IMGBB_API_KEY=your_imgbb_api_key

# ── SSLCommerz (Payment Gateway) ─────────────────────────────────────────────
SSL_STORE_ID=your_store_id
SSL_STORE_PASSWORD=your_store_password
# SSL_IS_LIVE=false   → false = sandbox/testing, true = live production
